[Unit]
Description=Lynceus web UI
Documentation=https://github.com/kevwillow/lynceus-warden
After=network-online.target lynceus.service
Wants=network-online.target lynceus.service

[Service]
Type=simple
User=lynceus
Group=lynceus
ExecStart=/opt/lynceus/.venv/bin/lynceus-ui --config /etc/lynceus/lynceus.yaml
Restart=on-failure
RestartSec=5s
StandardOutput=append:/var/log/lynceus/ui.log
StandardError=append:/var/log/lynceus/ui.err

# Hardening. UI reads the SQLite database read-only in practice but the
# sqlite3 driver still needs write access to the directory for journal/WAL
# sidecar files, so /var/lib/lynceus is in ReadWritePaths.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# ⛔ /etc/lynceus is NOT here, deliberately: the daemon must not be able to
# rewrite the operator's own config or the secrets in it. The UI allowlist
# (allowlist_ui.yaml) is daemon-written STATE and lives in /var/lib/lynceus
# for exactly that reason — it used to be written beside allowlist.yaml, and
# every web-UI suppression returned HTTP 500 on this install mode because the
# atomic write needs DIRECTORY write permission for its lock and tmp files.
ReadWritePaths=/var/lib/lynceus /var/log/lynceus

[Install]
WantedBy=multi-user.target
