[Unit]
Description=Lynceus RF security monitoring daemon
Documentation=https://github.com/kevwillow/lynceus-warden
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lynceus
Group=lynceus
ExecStart=/opt/lynceus/.venv/bin/lynceus --config /etc/lynceus/lynceus.yaml
Restart=on-failure
RestartSec=5s
StandardOutput=append:/var/log/lynceus/daemon.log
StandardError=append:/var/log/lynceus/daemon.err

# Hardening, daemon only needs to read /etc/lynceus and write the SQLite
# database under /var/lib/lynceus and logs under /var/log/lynceus. Kismet
# is reached over localhost so no extra network paths are required.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# ⛔ /etc/lynceus is NOT here, deliberately: the daemon must not be able to
# rewrite the operator's own config or the secrets in it. The UI allowlist
# (allowlist_ui.yaml) is daemon-written STATE and lives in /var/lib/lynceus
# for exactly that reason — it used to be written beside allowlist.yaml, and
# every web-UI suppression returned HTTP 500 on this install mode because the
# atomic write needs DIRECTORY write permission for its lock and tmp files.
ReadWritePaths=/var/lib/lynceus /var/log/lynceus

[Install]
WantedBy=multi-user.target
