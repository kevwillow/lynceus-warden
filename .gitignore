# Throwaway verification worktrees. .claude/gates.md tells you to create these
# INSIDE the repo (`git worktree add .claude/worktrees/verify`), so without
# this every gate run leaves an untracked directory that `git add -A` would
# happily commit -- a whole second checkout, venv symlink and all.
.claude/worktrees/

# Tests: publish the suite, except the files that describe the operator's own
# rig. The withheld ones embed the capture adapter's MAC (as the wlx<mac>
# interface name and as the 00:c0:ca OUI) or the rig account name, which is
# the reason the suite was held back wholesale in the first place. Everything
# else is ordinary unit testing and belongs in the repo, where a reader can
# run it and a CI job can gate on it.
#
# Adding a test that hard-codes a real adapter or host? Add it here too.
tests/Lynceus_wifi_probe.txt
tests/test_adapter_descriptors.py
tests/test_ble_bridge.py
tests/test_bootstrap_kismet.py
tests/test_diag_wifi_adapter_enrichment_parity.py
tests/test_diag_wizard_adapter_sysfs_matrix.py
tests/test_diag_wizard_step4.py
tests/test_kismet.py
tests/test_poller.py
tests/test_setup_core.py
tests/test_setup_web_kismet.py

# Internal CC working notes. Local-only, never published to the public repo
/CLAUDE.md

# Internal scratch: rig probes, throwaway spikes, local bundles. Never published.
/internal/

# Agent tooling state (session/telemetry scratch). Machine-local, not project
# content -- it varies per operator and per run and would be pure noise in a diff.
/.claude-flow/
